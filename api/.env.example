APP_NAME="The Experience"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=experience
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- The Experience ---
EXPERIENCE_WEATHER_DRIVER=open_meteo
EXPERIENCE_ROUTING_DRIVER=osrm
EXPERIENCE_ASSISTANT_DRIVER=rules
EXPERIENCE_TICKET_PROVIDER=deeplink
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
VIATOR_API_KEY=
GETYOURGUIDE_API_KEY=
DEEPLINK_AFFILIATE_ID=demo-partner
EXPERIENCE_PLACE_DATA_DRIVER=osm
EXPERIENCE_ENRICHMENT_DRIVER=wikimedia
GOOGLE_PLACES_API_KEY=
CONTACT_EMAIL=ops@example.com
# Where travellers write about their data. Shown on the public privacy policy,
# which both app stores require a URL for. Falls back to CONTACT_EMAIL.
PRIVACY_CONTACT_EMAIL=
# Dated on the policy page; a reviewer checks this against the content.
EXPERIENCE_PRIVACY_UPDATED="September 2026"
# The public home of the privacy policy — the URL both store listings carry.
# Put it on a domain you own so it survives the API moving host. Unset, the app
# links to this server's own /legal/privacy instead.
PRIVACY_POLICY_URL=https://experience.synteric.co.uk/privacy

# ── Deep links ───────────────────────────────────────────────────────────
# The domain whose https links open in the app. Both platforms verify this by
# fetching a file from the domain, which this app serves at /.well-known/.
APP_LINKS_HOST=experience.synteric.co.uk
APP_LINKS_ANDROID_PACKAGE=uk.co.synteric.experience
APP_LINKS_IOS_BUNDLE_ID=uk.co.synteric.experience
# SHA-256 of the signing certificate, comma-separated for more than one.
# Get it after the first build: eas credentials -p android
APP_LINKS_ANDROID_SHA256=
# Apple Developer team id, from the membership page.
APP_LINKS_IOS_TEAM_ID=
