APP_NAME="Interlude"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must include the scheme. Without one Laravel treats it as a relative path,
# so every generated URL becomes http://localhost/your-host/... — which fails
# in a way that looks like missing routes rather than bad configuration.
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=experience
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Interlude ---
EXPERIENCE_WEATHER_DRIVER=open_meteo
EXPERIENCE_ROUTING_DRIVER=osrm
EXPERIENCE_ASSISTANT_DRIVER=rules
EXPERIENCE_TICKET_PROVIDER=deeplink
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
VIATOR_API_KEY=
GETYOURGUIDE_API_KEY=
# Attribution for outbound GetYourGuide links and redirects. Without it a
# booking we sent them is a booking we are not paid for.
GETYOURGUIDE_PARTNER_ID=
# Both are required before the redirect supplier is offered at all: without
# somewhere to send a traveller there is no booking to redirect.
DEEPLINK_AFFILIATE_ID=
DEEPLINK_BASE_URL=
EXPERIENCE_PLACE_DATA_DRIVER=osm
EXPERIENCE_ENRICHMENT_DRIVER=wikimedia
DESTINATION_ACTIVATION_ENABLED=true
DESTINATION_ACTIVATION_ROLLOUT_PERCENTAGE=100
DESTINATION_ACTIVATION_ALLOWED_CITIES=
# provider:externalId CSV (e.g. nominatim:relation/12345) — bypasses rollout % like cities
DESTINATION_ACTIVATION_ALLOWED_CANDIDATES=
DESTINATION_ACTIVATION_DAILY_ACTOR_LIMIT=5
DESTINATION_ACTIVATION_DAILY_IP_LIMIT=10
DESTINATION_ACTIVATION_DAILY_GLOBAL_LIMIT=100
DESTINATION_PREWARM_ENABLED=false
DESTINATION_PREWARM_MINIMUM_DEMAND=10
DESTINATION_PREWARM_DAILY_LIMIT=3
DESTINATION_PREWARM_PER_RUN_LIMIT=3
DESTINATION_ACTIVATION_PLACE_LIMIT=20
DESTINATION_ENRICHMENT_RETRY_LIMIT=50
DESTINATION_READY_MINIMUM_PUBLISHED=5
DESTINATION_READY_MINIMUM_KINDS=3
GOOGLE_PLACES_API_KEY=
CONTACT_EMAIL=ops@example.com
# Where travellers write about their data. Shown on the public privacy policy,
# which both app stores require a URL for. Falls back to CONTACT_EMAIL.
PRIVACY_CONTACT_EMAIL=
# Dated on the policy page; a reviewer checks this against the content.
EXPERIENCE_PRIVACY_UPDATED="September 2026"
# The public home of the privacy policy — the URL both store listings carry.
# Put it on a domain you own so it survives the API moving host. Unset, the app
# links to this server's own /legal/privacy instead.
PRIVACY_POLICY_URL=https://experience.synteric.co.uk/privacy

# ── Deep links ───────────────────────────────────────────────────────────
# The domain whose https links open in the app. Both platforms verify this by
# fetching a file from the domain, which this app serves at /.well-known/.
APP_LINKS_HOST=experience.synteric.co.uk
APP_LINKS_ANDROID_PACKAGE=uk.co.synteric.experience
APP_LINKS_IOS_BUNDLE_ID=uk.co.synteric.experience
# SHA-256 of the signing certificate, comma-separated for more than one.
# Get it after the first build: eas credentials -p android
APP_LINKS_ANDROID_SHA256=
# Apple Developer team id, from the membership page.
APP_LINKS_IOS_TEAM_ID=
# What suppliers are asked to quote in, before display conversion.
EXPERIENCE_BASE_CURRENCY=GBP
