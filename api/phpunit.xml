<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="experience_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="EXPERIENCE_WEATHER_DRIVER" value="seeded" force="true"/>
        <env name="EXPERIENCE_ASSISTANT_DRIVER" value="rules" force="true"/>
        <env name="EXPERIENCE_ROUTING_DRIVER" value="osrm" force="true"/>
        <env name="EXPERIENCE_PLACE_DATA_DRIVER" value="osm" force="true"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>

        <!--
            Credentials are blanked for the test run, and forced so a populated
            .env cannot override them. Without this the suite picks up real keys
            from the developer's environment: adapters that are supposed to be
            inert become active, fixtures stop matching, and a CI run can spend
            money against a live billing account.
        -->
        <env name="GOOGLE_PLACES_API_KEY" value="" force="true"/>
        <env name="VIATOR_API_KEY" value="" force="true"/>
        <env name="GETYOURGUIDE_API_KEY" value="" force="true"/>
        <env name="ANTHROPIC_API_KEY" value="" force="true"/>
    </php>
</phpunit>
