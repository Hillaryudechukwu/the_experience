{
  "expo": {
    "name": "WAYOA",
    "slug": "wayoa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.co.synteric.experience",
      "entitlements": {
        "aps-environment": "production"
      },
      "associatedDomains": [
        "applinks:experience.synteric.co.uk"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used only to work out what is worth doing near you right now. You can decline and pick a city instead.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1B2A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "uk.co.synteric.experience",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "experience.synteric.co.uk",
              "pathPrefix": "/experience"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "WAYOA — Know where to go",
      "shortName": "WAYOA",
      "description": "WAYOA helps travellers discover, plan and book experiences that fit their journey.",
      "lang": "en",
      "themeColor": "#0D1B2A",
      "backgroundColor": "#0D1B2A",
      "display": "standalone",
      "splash": {
        "backgroundColor": "#0D1B2A",
        "resizeMode": "contain",
        "image": "./assets/brand/wayoa-logo.png"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://experience.synteric.co.uk"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1B2A",
          "image": "./assets/brand/wayoa-app-icon.png",
          "imageWidth": 240
        }
      ],
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used only to work out what is worth doing near you right now."
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "scheme": [
      "wayoa",
      "interlude",
      "com.googleusercontent.apps.1057354438819-3s104cblbau8p59clq27dpumcpnljqnv",
      "com.googleusercontent.apps.1057354438819-8c1h7ukdcve8fu987u14pvs7b7sbble9"
    ],
    "extra": {
      "router": {
        "origin": "https://experience.synteric.co.uk"
      },
      "eas": {
        "projectId": "588b5410-a890-4805-8c97-33f7cd965e06"
      }
    },
    "owner": "hillaryudechukwus-team"
  }
}
